#!/bin/bash
##############################################################################
# Ajoute l'utilitaire "Cache gate Decypharr" (Sonarr v5).
#
# Ce patch n'installe rien : il ajoute l'option de menu, l'entree catalogue
# et le chargement du fichier de menu. L'installation se fait ensuite depuis
# le menu, au choix de l'utilisateur.
#
# Idempotent : peut etre rejoue via FORCE_PATCH.
##############################################################################

set -u

if [ -z "${SETTINGS_SOURCE:-}" ] && [ -f "${HOME}/.config/ssd/env" ]; then
  # shellcheck disable=SC1090
  source "${HOME}/.config/ssd/env"
fi
SETTINGS_SOURCE="${SETTINGS_SOURCE:-${HOME}/seedbox-compose}"

MENU="${SETTINGS_SOURCE}/menu"
CATALOG="${SETTINGS_SOURCE}/includes/config/services-available"
MENUS="${SETTINGS_SOURCE}/includes/menus.sh"

command -v sqlite3 >/dev/null 2>&1 || exit 0

# 1. Entree de menu sous "Gestion -> Utilitaires" (parent 7).
#    Fallback sous "Gestion" (parent 2) si le parent 7 n'existe pas.
if [ -f "$MENU" ]; then
  parent=7
  ordre=4
  if ! sqlite3 "$MENU" "select 1 from menu where id=7" 2>/dev/null | grep -qx 1; then
    parent=2
    ordre=6
  fi
  sqlite3 "$MENU" "insert into menu (texte,parent_id,ordre,action)
  select 'Cache gate Decypharr (Sonarr v5)',${parent},${ordre},'menu_decypharrgate'
  where not exists (select 1 from menu where action='menu_decypharrgate');" 2>/dev/null
  # Repositionne une entree creee par une version precedente (parent 9).
  sqlite3 "$MENU" "update menu set parent_id=${parent}, ordre=${ordre}
  where action='menu_decypharrgate';" 2>/dev/null
fi

# 2. Entree catalogue.
catalog_line="decypharrgate - Cache gate Decypharr pour Sonarr v5 (file d'attente propre, sans blocklist)"
if [ -f "$CATALOG" ] && ! grep -qxF -- "$catalog_line" "$CATALOG"; then
  printf '%s\n' "$catalog_line" >>"$CATALOG"
fi

# 3. Chargement du fichier de menu (bloc protege par marqueur).
if [ -f "$MENUS" ] && ! grep -q '# BEGIN decypharrgate' "$MENUS"; then
  cat >>"$MENUS" <<'EOF'

# BEGIN decypharrgate
# Menu de gestion de la cache gate decypharr (Sonarr v5).
if [ -f "${SETTINGS_SOURCE}/includes/menus-decypharrgate.sh" ]; then
  # shellcheck source=menus-decypharrgate.sh
  source "${SETTINGS_SOURCE}/includes/menus-decypharrgate.sh"
fi
# END decypharrgate
EOF
fi

# 4. Verification des fichiers applicatifs (livres avec le depot).
for f in \
  includes/dockerapps/vars/decypharrgate.yml \
  includes/dockerapps/posttasks/decypharrgate.yml \
  includes/dockerapps/templates/decypharrgate/default.conf \
  includes/config/scripts/decypharrgate.py \
  includes/menus-decypharrgate.sh \
  docs/decypharrgate.md; do
  if [ ! -f "${SETTINGS_SOURCE}/${f}" ]; then
    echo "[patch] ATTENTION : fichier manquant ${f}" >&2
  fi
done

echo "[patch] option 'Cache gate Decypharr (Sonarr v5)' ajoutee"
exit 0
