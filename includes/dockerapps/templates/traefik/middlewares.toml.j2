[http.middlewares.middlewares-basic-auth]
  [http.middlewares.middlewares-basic-auth.basicAuth]
    users = [
      "{{user.htpwd}}",
    ]


[http.middlewares.middlewares-rate-limit]
  [http.middlewares.middlewares-rate-limit.rateLimit]
    average = 100
    burst = 50


[http.middlewares.middlewares-secure-headers]
  [http.middlewares.middlewares-secure-headers.headers]
    accessControlAllowMethods = ["GET", "OPTIONS", "PUT"]
    accessControlMaxAge = 100
    hostsProxyHeaders = ["X-Forwarded-Host"]
    sslRedirect = true
    stsSeconds = 63072000
    stsIncludeSubdomains = true
    stsPreload = true
    forceSTSHeader = true
    customFrameOptionsValue = "SAMEORIGIN"
    contentTypeNosniff = true 
    browserXssFilter = true 
    referrerPolicy = "same-origin" 
    featurePolicy = "camera 'none'; geolocation 'none'; microphone 'none'; payment 'none'; usb 'none'; vr 'none';" 
    [http.middlewares.middlewares-secure-headers.headers.customResponseHeaders]
      X-Robots-Tag = "none,noarchive,nosnippet,notranslate,noimageindex,"
      server = ""


[http.middlewares.middlewares-oauth]
  [http.middlewares.middlewares-oauth.forwardAuth]
    address = "http://oauth:4181"
    trustForwardHeader = true
    authResponseHeaders = ["X-Forwarded-User"]


[http.middlewares.middlewares-authelia]
  [http.middlewares.middlewares-authelia.forwardAuth]
    address = "http://authelia:9091/api/verify?rd=https://authelia.{{user.domain}}"
    trustForwardHeader = true
    authResponseHeaders = ["Remote-User", "Remote-Groups"]


# ✅ Error middleware pour redirection vers login OAuth2.
# Uniquement 401 : les 403 applicatifs (CSRF, permissions) doivent rester intacts.
# Ce middleware ne doit être appliqué qu'aux routeurs de navigation HTML ; les
# routeurs API/SSE utilisent chain-oauth2-proxy-api (sans errors).
[http.middlewares.middlewares-oauth2-errors.errors]
  status = ["401"]
  service = "oauth2proxy-svc@docker"
  query = "/oauth2/sign_in?rd={url}"


[http.routers.oauth2-proxy-path]
  rule = "HostRegexp(`^[a-z0-9-]+[.]{{ user.domain }}$`) && PathPrefix(`/oauth2/`)"
  entryPoints = ["https"]
  # Priorité haute : ce routeur ne doit jamais être éclipsé par un routeur applicatif.
  priority = 1000
  service = "oauth2proxy-svc@docker"
  middlewares = ["chain-no-auth@file"]
  [http.routers.oauth2-proxy-path.tls]
    certResolver = "letsencrypt"


# ⭐ OAuth2 Proxy - ForwardAuth Configuration
[http.middlewares.middlewares-oauth2-proxy]
  [http.middlewares.middlewares-oauth2-proxy.forwardAuth]
    address = "http://oauth2-proxy:4180/oauth2/auth"
    # Ne pas relayer un X-Forwarded-Uri fourni par le client : Traefik réécrit
    # les en-têtes depuis la requête réelle (défense en profondeur CVE-2026-40575).
    # trustForwardHeader est déprécié dans Traefik v3.
    # Recopier le cookie de session rafraîchi vers le navigateur. Sans cela,
    # le refresh est rejoué à chaque requête (cookie obsolète côté client).
    addAuthCookiesToResponse = ["_oauth2_proxy"]
    # ⭐ IMPORTANT: Headers renvoyés par oauth2-proxy au container upstream
    authResponseHeaders = [
      "X-Auth-Request-User",
      "X-Auth-Request-Email",
      "X-Auth-Request-Preferred-Username"
    ]


# ==============================
# ALLOWLIST CLOUDFLARE (uniquement)
# Utilisee par les chaines non-Plex lorsque plex.public_https=true.
# Source unique des CIDR : includes/dockerapps/vars/traefik.yml
# Aucun reseau prive/Tailscale : l'acces direct public reste interdit.
# ==============================

[http.middlewares.middlewares-allowlist.ipAllowList]
  sourceRange = [
{% for ip in traefik_allowlist_ips %}
    "{{ ip }}",
{% endfor %}
  ]


# ==============================
# TRANSPORT PLEX (Traefik -> Plex en HTTPS)
# Le certificat Plex est un certificat plex.direct : verification ignoree.
# ==============================

[http.serversTransports.plex-transport]
  insecureSkipVerify = true
