# Les chaines non-Plex recoivent l'allowlist Cloudflare (uniquement)
# uniquement lorsque le mode Plex public HTTPS est actif (opt-in).
{% set cloudflare_only = traefik_cloudflare_only | default(false) | bool %}
{% set allowlist_tail = ',\n    "middlewares-allowlist@file"' if cloudflare_only else '' %}
{% set allowlist_entry = '    "middlewares-allowlist@file",\n' if cloudflare_only else '' %}
# ==============================
# CHAIN NO AUTH
# ==============================

[http.middlewares.chain-no-auth.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file"{{ allowlist_tail }}
  ]


# ==============================
# CHAIN BASIC AUTH
# ==============================

[http.middlewares.chain-basic-auth.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file",
{{ allowlist_entry }}    "middlewares-basic-auth@file"
  ]


# ==============================
# CHAIN OAUTH
# ==============================

[http.middlewares.chain-oauth.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file",
{{ allowlist_entry }}    "middlewares-oauth@file"
  ]


# ==============================
# CHAIN AUTHELIA
# ==============================

[http.middlewares.chain-authelia.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file",
{{ allowlist_entry }}    "middlewares-authelia@file"
  ]


# ==============================
# CHAIN OAUTH2 PROXY
# ==============================

[http.middlewares.chain-oauth2-proxy.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file",
{{ allowlist_entry }}    "middlewares-oauth2-errors@file",
    "middlewares-oauth2-proxy@file"
  ]


# ==============================
# CHAIN PLEX (public HTTPS, WAF/CrowdSec, SANS allowlist)
# Plex doit rester joignable directement en 443 depuis les clients Plex.
# ==============================

[http.middlewares.chain-plex.chain]
  middlewares = [
    "crowdsec@file",
    "middlewares-rate-limit@file",
    "middlewares-secure-headers@file"
  ]
